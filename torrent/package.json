{
  "name": "torrent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A room of pears over Hyperswarm: join open problems, chat, get a name from the coordinator.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "pear": "tsx src/pear.tsx",
    "room": "node scripts/guillefix.cjs pears",
    "orchestrator": "tsx scripts/orchestrator.ts",
    "message": "tsx scripts/message.ts",
    "transcript": "tsx scripts/transcript.ts",
    "agent": "tsx scripts/agent.ts",
    "discord": "node --env-file-if-exists=.env.local --import tsx scripts/discord.ts",
    "discord:costs": "node --import tsx scripts/discord-costs.ts",
    "fragment-submit": "tsx scripts/fragment-submit.ts",
    "fragment-velocity": "tsx scripts/fragment-velocity.ts",
    "fragment-compute": "tsx scripts/fragment-compute.ts",
    "lint": "oxlint && prettier --check .",
    "fmt": "prettier --write . && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "hyperswarm": "^4.17.1",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "tsx": "^4.23.13",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.17.0"
}
