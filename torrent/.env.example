# Copy to .env.local (ignored by git), then fill locally. Do not paste secrets into chat.
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
DISCORD_CHANNEL_ID=
PEAR_MODEL=
# Optional: allow plain follow-ups inside existing bot threads.
# Also enable Message Content Intent on the application's Bot page.
DISCORD_MESSAGE_CONTENT=0
# Optional: comma-separated Discord user IDs; empty allows everyone in the configured channel.
DISCORD_USER_IDS=
# Minting invites (pnpm invite): your Headscale and an API key from `headscale apikeys create`.
HEADSCALE_URL=
HEADSCALE_API_KEY=
